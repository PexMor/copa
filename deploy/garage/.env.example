# Copy to .env (or just run ./init.sh, which generates it with a fresh secret).

# Garage cluster RPC secret — 32 random bytes, hex. Generate: openssl rand -hex 32
GARAGE_RPC_SECRET=

# Garage image tag
GARAGE_IMAGE=dxflrs/garage:v2.1.0

# Host address and port for the S3 API. Keep 127.0.0.1 and put a reverse proxy
# in front; 0.0.0.0 exposes plain-http S3 to the network (LAN testing only).
COPA_S3_BIND=127.0.0.1
COPA_S3_PORT=3900

# Bucket and access key created for copasrv
COPA_BUCKET=copa
COPA_KEY_NAME=copa

# Capacity announced for the single node
GARAGE_CAPACITY=10G

# Web app origins allowed to upload/download from a browser (space separated,
# explicit list — never "*" for an internet-facing setup)
COPA_CORS_ORIGINS="http://127.0.0.1:8080 http://localhost:8080 http://localhost:5173"

# Backstop: the store itself deletes objects under copa/ after this many days,
# even if copasrv never runs again. Must exceed your largest item_ttl_secs.
COPA_LIFECYCLE_DAYS=8

# What clients use to reach the S3 API (printed into the [server.storage] block).
# Behind a reverse proxy set this to the public https URL.
COPA_S3_PUBLIC_URL=http://127.0.0.1:3900

# Only for the optional "caddy" profile (see proxy/Caddyfile)
COPA_HOST=copa.localhost
COPA_S3_HOST=s3.localhost
COPA_HTTPS_PORT=8443
COPA_UPSTREAM=127.0.0.1:8080
# Set to "local_certs" to force Caddy's internal CA for non-.localhost test names
COPA_LOCAL_CERTS=
